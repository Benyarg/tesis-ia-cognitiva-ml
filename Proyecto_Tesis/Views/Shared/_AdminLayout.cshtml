@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@antiforgeryTokens.RequestToken" />
    <title>@ViewData["Title"] - Administración</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin/admin.css" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a asp-controller="Admin" asp-action="Index" class="admin-brand">
    <span class="admin-logo-container">
        <img src="~/img/brand/logo.png"
             class="admin-brand-logo"
             alt=""
             aria-hidden="true" />
    </span>

    <span>
        <strong>IA Cognitiva</strong>
        <small>Administración</small>
    </span>
</a>
            <nav class="admin-nav" aria-label="Navegación administrativa">
                <a asp-controller="Admin" asp-action="Index">Resumen</a>
                <a asp-controller="Admin" asp-action="Participantes">Participantes</a>
            </nav>
            <form asp-controller="AdminAccount" asp-action="Logout" method="post" class="admin-logout">
                <button type="submit">Cerrar sesión</button>
            </form>
        </aside>
        <div class="admin-content">
            <header class="admin-topbar">
                <div>
                    <span class="admin-eyebrow">Área privada</span>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <span class="admin-user">@User.Identity?.Name</span>
            </header>
            <main class="admin-main">
                @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
                @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
