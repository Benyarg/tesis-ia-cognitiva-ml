@{
    ViewData["Title"] = "Resultado Final";
}
<link href="~/css/views-investigacion/resultado-final.css" rel="stylesheet" />

<div class="result-container">
    <div class="header-card">
        <h2>Análisis final</h2>
        <p style="color:#64748b;margin-top:10px;font-size:.95rem;">
            Estamos procesando los indicadores registrados durante tu evaluación.
        </p>
    </div>

    <div id="resultadoBox" style="display:block;" role="status" aria-live="polite">
        <div class="res-text-sub">Procesando evaluación...</div>
    </div>

    <div class="thanks-footer">
        <p><strong>Gracias por participar.</strong></p>
        <p style="margin-top:5px;opacity:.8;">Tu participación contribuye a esta investigación universitaria.</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/views-investigacion/resultado-final.js" defer></script>
}
