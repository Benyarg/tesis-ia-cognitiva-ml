@model Proyecto_Tesis.ViewModels.Admin.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<section class="stats-grid">
    <article class="stat-card">
        <span>Participantes</span>
        <strong>@Model.Participantes</strong>
        <small>Participantes registrados</small>
    </article>

    <article class="stat-card">
        <span>Evaluaciones completas</span>
        <strong>@Model.EvaluacionesCompletas</strong>
        <small>Flujo finalizado</small>
    </article>

    <article class="stat-card">
        <span>Resultados generados</span>
        <strong>@Model.PrediccionesGeneradas</strong>
        <small>Predicciones registradas</small>
    </article>

    <article class="stat-card">
        <span>Consentimientos</span>
        <strong>@Model.ConsentimientosAceptados</strong>
        <small>Aceptados</small>
    </article>
</section>

<div class="admin-grid-2 mt-4">

    <!-- DISTRIBUCIÓN DE RESULTADOS -->
    <section class="panel-card">
        <div class="panel-heading">
            <div>
                <span class="admin-eyebrow">Distribución</span>
                <h2>Niveles predichos</h2>
            </div>
        </div>

        <div class="risk-summary">
            <div class="risk-box risk-high">
                <span>Nivel alto</span>
                <strong>@Model.NivelAlto</strong>
            </div>

            <div class="risk-box risk-low">
                <span>Nivel bajo</span>
                <strong>@Model.NivelBajo</strong>
            </div>
        </div>

        <p class="panel-note">
            Los niveles corresponden a la salida predictiva del sistema
            y no representan diagnósticos clínicos.
        </p>
    </section>


    <!-- MACHINE LEARNING -->
    <section class="panel-card">

        <div class="panel-heading">
            <div>
                <span class="admin-eyebrow">Machine Learning</span>
                <h2>Evaluación del modelo</h2>
            </div>

            <span class="badge rounded-pill text-bg-light border">
                Entorno demo
            </span>
        </div>

        @if (Model.UltimoModelo is null)
        {
            <p class="empty-state">
                Aún no se ha realizado una evaluación del modelo.
            </p>
        }
        else
        {
            <div class="metrics-grid">
                <div>
                    <span>Accuracy</span>
                    <strong>
                        @Model.UltimoModelo.Accuracy.ToString("P1")
                    </strong>
                </div>

                <div>
                    <span>Precisión</span>
                    <strong>
                        @Model.UltimoModelo.Precision.ToString("P1")
                    </strong>
                </div>

                <div>
                    <span>Recall</span>
                    <strong>
                        @Model.UltimoModelo.Recall.ToString("P1")
                    </strong>
                </div>

                <div>
                    <span>F1-score</span>
                    <strong>
                        @Model.UltimoModelo.F1.ToString("P1")
                    </strong>
                </div>
            </div>

            <small class="text-muted">
                Última evaluación:
                @Model.UltimoModelo.Fecha
                    .ToLocalTime()
                    .ToString("dd/MM/yyyy HH:mm")
            </small>
        }

        <form asp-controller="Admin"
              asp-action="EntrenarModelo"
              method="post"
              class="mt-3">

            <button type="submit"
                    class="btn btn-outline-primary">
                Entrenar y evaluar modelo
            </button>
        </form>

        <p class="panel-note">
            Las métricas corresponden a los datos disponibles en este
            entorno demostrativo y no representan la validación experimental
            del estudio.
        </p>

    </section>

</div>


<!-- PARTICIPANTES RECIENTES -->
<section class="panel-card mt-4">

    <div class="panel-heading">
        <div>
            <span class="admin-eyebrow">Actividad</span>
            <h2>Participantes recientes</h2>
        </div>

        <a asp-controller="Admin"
           asp-action="Participantes"
           class="btn btn-sm btn-outline-secondary">
            Ver todos
        </a>
    </div>

    <div class="table-responsive">

        <table class="table admin-table align-middle">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Registro</th>
                    <th>Estado</th>
                    <th>Resultado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

            @foreach (var item in Model.Recientes)
            {
                <tr>
                    <td>
                        <strong>@item.Codigo</strong>
                    </td>

                    <td>
                        @item.FechaRegistro
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        <span class="status-pill">
                            @item.Estado
                        </span>
                    </td>

                    <td>
                        <span class="risk-pill @(item.Nivel == "ALTO"
                            ? "high"
                            : item.Nivel == "BAJO"
                                ? "low"
                                : "neutral")">

                            @item.Nivel

                        </span>
                    </td>

                    <td>
                        <a asp-controller="Admin"
                           asp-action="Detalle"
                           asp-route-id="@item.Id">
                            Detalle
                        </a>
                    </td>
                </tr>
            }

            </tbody>

        </table>

    </div>

</section>